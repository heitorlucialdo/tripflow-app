# Copie para backend/.env e preencha. Nunca commite o .env.

# Supabase (Project Settings > API e Connect > Session pooler)
DATABASE_URL=
SUPABASE_URL=
# A chave pública basta para validar o login; a service key é opcional.
SUPABASE_ANON_KEY=
FRONTEND_URL=http://localhost:5173

# IA: qualquer servidor compatível com a API da OpenAI.
# LM Studio local (gratuito): AI_BASE_URL=http://localhost:1234/v1 e AI_MODEL com o nome do modelo carregado.
# Ollama local (gratuito):    AI_BASE_URL=http://localhost:11434/v1
# OpenAI:                     deixe AI_BASE_URL vazio e preencha AI_API_KEY.
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
# Modelo com visão para foto de nota fiscal (se diferente do AI_MODEL)
AI_VISION_MODEL=
# Use false se o modelo local não aceitar json_schema
AI_STRICT_JSON=true

# Busca de passagens (https://serpapi.com, 250 buscas/mês grátis)
SERPAPI_KEY=

# Cache opcional
UPSTASH_REDIS_URL=
UPSTASH_REDIS_TOKEN=
