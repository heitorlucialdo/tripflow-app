generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Profile {
  id        String   @id @db.Uuid
  name      String
  avatarUrl String?  @map("avatar_url")
  email     String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tripsCreated Trip[]
  memberships  TripMember[]
  invitesCreated Invite[]   @relation("InviteCreator")
  invitesUsed    Invite[]   @relation("InviteUser")
  photos       Photo[]
  expenses     Expense[]
  checklist    ChecklistItem[]
  locations    Location[]
  photoLikes   PhotoLike[]

  @@map("profiles")
}

model Trip {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name            String
  origin          String
  destination     String
  originIata      String?  @map("origin_iata")
  destinationIata String?  @map("destination_iata")
  startDate       DateTime @map("start_date") @db.Date
  endDate         DateTime @map("end_date") @db.Date
  coverImageUrl   String?  @map("cover_image_url")
  createdBy       String   @map("created_by") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  creator    Profile        @relation(fields: [createdBy], references: [id])
  members    TripMember[]
  invites    Invite[]
  photos     Photo[]
  expenses   Expense[]
  checklist  ChecklistItem[]
  locations  Location[]

  @@map("trips")
}

model TripMember {
  tripId   String   @map("trip_id") @db.Uuid
  userId   String   @map("user_id") @db.Uuid
  role     String   @default("member")
  joinedAt DateTime @default(now()) @map("joined_at")

  trip Trip    @relation(fields: [tripId], references: [id], onDelete: Cascade)
  user Profile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([tripId, userId])
  @@map("trip_members")
}

model Invite {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tripId    String    @map("trip_id") @db.Uuid
  token     String    @unique @db.Uuid
  createdBy String    @map("created_by") @db.Uuid
  expiresAt DateTime  @map("expires_at")
  usedBy    String?   @map("used_by") @db.Uuid
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  trip    Trip    @relation(fields: [tripId], references: [id], onDelete: Cascade)
  creator Profile @relation("InviteCreator", fields: [createdBy], references: [id], onDelete: Cascade)
  user    Profile? @relation("InviteUser", fields: [usedBy], references: [id], onDelete: SetNull)

  @@map("invites")
}

model Photo {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tripId      String   @map("trip_id") @db.Uuid
  uploaderId  String   @map("uploader_id") @db.Uuid
  storagePath String   @map("storage_path")
  caption     String?
  takenAt     DateTime @default(now()) @map("taken_at")
  createdAt   DateTime @default(now()) @map("created_at")

  trip     Trip       @relation(fields: [tripId], references: [id], onDelete: Cascade)
  uploader Profile    @relation(fields: [uploaderId], references: [id], onDelete: Cascade)
  likes    PhotoLike[]

  @@map("photos")
}

model PhotoLike {
  photoId   String   @map("photo_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  photo Photo   @relation(fields: [photoId], references: [id], onDelete: Cascade)
  user  Profile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([photoId, userId])
  @@map("photo_likes")
}

model Expense {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tripId       String   @map("trip_id") @db.Uuid
  description  String
  amount       Decimal  @db.Decimal(10, 2)
  category     String   @default("Outros")
  paidBy       String   @map("paid_by") @db.Uuid
  participants String[] @db.Uuid
  date         DateTime @db.Date
  createdAt    DateTime @default(now()) @map("created_at")

  trip  Trip    @relation(fields: [tripId], references: [id], onDelete: Cascade)
  payer Profile @relation(fields: [paidBy], references: [id])

  @@map("expenses")
}

model ChecklistItem {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tripId    String    @map("trip_id") @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  placeName String    @map("place_name")
  checkedAt DateTime? @map("checked_at")

  trip Trip    @relation(fields: [tripId], references: [id], onDelete: Cascade)
  user Profile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tripId, userId, placeName])
  @@map("checklist_items")
}

model Location {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tripId    String   @map("trip_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  latEnc    String   @map("lat_enc")
  lngEnc    String   @map("lng_enc")
  updatedAt DateTime @updatedAt @map("updated_at")

  trip Trip    @relation(fields: [tripId], references: [id], onDelete: Cascade)
  user Profile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tripId, userId])
  @@map("locations")
}
